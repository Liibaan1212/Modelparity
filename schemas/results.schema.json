{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://modelparity.dev/schemas/results.schema.json",
  "title": "ModelParity Run Results",
  "description": "Schema for the JSON results file produced by a ModelParity run.",
  "type": "object",
  "required": [
    "run_id",
    "run_started_at",
    "run_finished_at",
    "tool_version",
    "python_version",
    "suite_hash",
    "suite_name",
    "results",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this run (UUID v4 recommended)."
    },
    "run_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the run started."
    },
    "run_finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the run finished."
    },
    "tool_version": {
      "type": "string",
      "description": "Version of ModelParity that produced this results file."
    },
    "python_version": {
      "type": "string",
      "description": "Python runtime version (e.g. '3.11.9')."
    },
    "suite_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex digest of the canonical suite file contents."
    },
    "suite_name": {
      "type": "string",
      "description": "Name of the suite as declared in suite.suite.name."
    },
    "results": {
      "type": "array",
      "items": { "$ref": "#/definitions/TestResult" },
      "description": "Per-test results ordered by test declaration order."
    },
    "summary": {
      "$ref": "#/definitions/RunSummary"
    }
  },
  "definitions": {
    "TestResult": {
      "type": "object",
      "required": ["test_id", "reference", "candidate", "comparison"],
      "additionalProperties": false,
      "properties": {
        "test_id": {
          "type": "string",
          "description": "The test ID as declared in the suite."
        },
        "reference": {
          "$ref": "#/definitions/EndpointResult"
        },
        "candidate": {
          "$ref": "#/definitions/EndpointResult"
        },
        "comparison": {
          "$ref": "#/definitions/ComparisonResult"
        }
      }
    },
    "EndpointResult": {
      "type": "object",
      "required": ["status", "assertions"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "CONTRACT_FAIL",
            "REQUEST_ERROR",
            "BASELINE_FAIL",
            "INCONCLUSIVE",
            "SKIPPED"
          ],
          "description": "Overall status for this endpoint on this test."
        },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/definitions/AssertionResult" },
          "description": "Per-assertion evaluation results."
        },
        "error": {
          "type": ["string", "null"],
          "description": "Human-readable error message if status is REQUEST_ERROR or similar."
        },
        "latency_ms": {
          "type": ["number", "null"],
          "description": "Round-trip latency in milliseconds, if available."
        },
        "response_text": {
          "type": ["string", "null"],
          "description": "Captured response text, if capture.response_text is true."
        },
        "finish_reason": {
          "type": ["string", "null"],
          "description": "finish_reason returned by the model, if available."
        },
        "usage": {
          "$ref": "#/definitions/TokenUsage"
        }
      }
    },
    "AssertionResult": {
      "type": "object",
      "required": ["type", "passed"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "Assertion type identifier."
        },
        "passed": {
          "type": "boolean",
          "description": "Whether this assertion passed."
        },
        "message": {
          "type": ["string", "null"],
          "description": "Optional diagnostic message explaining a failure."
        }
      }
    },
    "ComparisonResult": {
      "type": "object",
      "required": ["transition", "overall"],
      "additionalProperties": false,
      "properties": {
        "transition": {
          "type": "string",
          "enum": [
            "PASS->PASS",
            "PASS->FAIL",
            "FAIL->PASS",
            "FAIL->FAIL"
          ],
          "description": "Transition string encoding reference->candidate outcome."
        },
        "overall": {
          "type": "string",
          "description": "Human-readable verdict for this test (e.g. 'regression', 'improvement', 'stable_pass')."
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Non-fatal warnings about this test comparison."
        }
      }
    },
    "TokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "RunSummary": {
      "type": "object",
      "required": ["total", "passed", "failed", "inconclusive", "skipped"],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of tests in the run."
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tests that passed on both endpoints."
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tests with at least one assertion failure."
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of inconclusive tests."
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of skipped tests."
        }
      }
    }
  }
}
